generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  REQUESTER
  APPROVER
  AP_PROCESSOR
  AP_REVIEWER
  ADMIN
  AUDITOR
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  PENDING_MANAGER_APPROVAL
  RETURNED_FOR_REVISION
  RESUBMITTED
  REJECTED
  MANAGER_APPROVED
  PENDING_AP_VALIDATION
  RETURNED_BY_AP
  ON_HOLD
  PENDING_ACCOUNTING_REVIEW
  ACCOUNTING_APPROVED
  READY_FOR_DOCUMENT_GENERATION
  DOCUMENT_GENERATED
  REPOSITORY_SAVE_PENDING
  REPOSITORY_SAVE_FAILED
  READY_FOR_QUICKBOOKS
  QUICKBOOKS_FILE_GENERATED
  QUICKBOOKS_POSTING_PENDING
  POSTED_TO_QUICKBOOKS
  PAYMENT_SCHEDULED
  PAYMENT_PROCESSING
  PAID
  RECONCILIATION_PENDING
  RECONCILED
  CLOSED
  CANCELLED
  INTEGRATION_ERROR
}

enum Decision {
  APPROVED
  RETURNED
  REJECTED
}

enum DocumentScanStatus {
  PENDING
  CLEAN
  REJECTED
  ERROR
}

enum Confidentiality {
  INTERNAL
  CONFIDENTIAL
  RESTRICTED_PAYROLL
  RESTRICTED_BANKING
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

enum PaymentStatus {
  SCHEDULED
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REVERSED
}

enum RepositoryStatus {
  PENDING
  STORED
  FAILED
}

model User {
  id              String                 @id @default(cuid())
  email           String                 @unique
  passwordHash    String
  fullName        String
  departmentId    String?
  department      Department?            @relation(fields: [departmentId], references: [id])
  active          Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  roles           UserRole[]
  requested       Request[]              @relation("Requester")
  createdFor      Request[]              @relation("CreatedBy")
  attestations    RequestAttestation[]
  assignments     ApprovalAssignment[]   @relation("AssignedApprover")
  assignedBy      ApprovalAssignment[]   @relation("AssignmentCreator")
  decisions       ApprovalDecision[]
  uploads         SupportingDocument[]
  adjustments     AccountingAdjustment[]
  payments        Payment[]
  reconciliations Reconciliation[]
  comments        Comment[]
  notifications   Notification[]
  audits          AuditEvent[]
  delegationsFrom Delegation[]           @relation("Delegator")
  delegationsTo   Delegation[]           @relation("Delegate")
}

model Role {
  id          String           @id @default(cuid())
  code        RoleCode         @unique
  name        String
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  code  String           @unique
  name  String
  roles RolePermission[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  companyId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  company   Company? @relation(fields: [companyId], references: [id])

  @@unique([userId, roleId, companyId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Company {
  id              String              @id @default(cuid())
  code            String              @unique
  name            String
  active          Boolean             @default(true)
  defaultCurrency String              @default("PHP")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  branding        CompanyBranding?
  departments     Department[]
  projectCodes    ProjectCode[]
  accounts        Account[]
  payees          Payee[]
  requests        Request[]
  userRoles       UserRole[]
  workflows       ApprovalWorkflow[]
  mappings        AccountingMapping[]
  sequences       NumberSequence[]
}

model CompanyBranding {
  id                   String  @id @default(cuid())
  companyId            String  @unique
  company              Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  legalDisplayName     String
  address              String
  telephone            String
  fax                  String?
  logoStorageKey       String?
  primaryColor         String  @default("#111827")
  pdfAfterApValidation Boolean @default(false)
}

model Department {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  code      String
  name      String
  active    Boolean   @default(true)
  users     User[]
  requests  Request[]

  @@unique([companyId, code])
}

model ProjectCode {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  code          String
  name          String
  active        Boolean       @default(true)
  lines         RequestLine[] @relation("RequestedProject")
  adjustedLines RequestLine[] @relation("AdjustedProject")

  @@unique([companyId, code])
}

model Account {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  code          String
  name          String
  qbAccountId   String?
  active        Boolean       @default(true)
  lines         RequestLine[] @relation("RequestedAccount")
  adjustedLines RequestLine[] @relation("AdjustedAccount")

  @@unique([companyId, code])
}

model AccountingClass {
  id     String  @id @default(cuid())
  code   String  @unique
  name   String
  active Boolean @default(true)
}

model CostCenter {
  id     String  @id @default(cuid())
  code   String  @unique
  name   String
  active Boolean @default(true)
}

model NatureOfPayment {
  id           String                @id @default(cuid())
  code         String                @unique
  displayLabel String
  sortOrder    Int
  active       Boolean               @default(true)
  sensitive    Boolean               @default(false)
  requests     Request[]
  rules        NatureOfPaymentRule[]
}

model NatureOfPaymentRule {
  id                String          @id @default(cuid())
  natureOfPaymentId String
  natureOfPayment   NatureOfPayment @relation(fields: [natureOfPaymentId], references: [id])
  key               String
  label             String
  required          Boolean         @default(true)
  ruleType          String
  config            Json?
  active            Boolean         @default(true)

  @@unique([natureOfPaymentId, key])
}

model Payee {
  id               String    @id @default(cuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id])
  type             String
  displayName      String
  externalRef      String?
  maskedBankRef    String?
  encryptedDetails String?
  active           Boolean   @default(true)
  requests         Request[]

  @@index([companyId, displayName])
}

model Request {
  id                 String                 @id @default(cuid())
  draftIdentifier    String                 @unique
  requestNumber      String?                @unique
  invoiceNumber      String?                @unique
  apvNumber          String?                @unique
  companyId          String
  company            Company                @relation(fields: [companyId], references: [id])
  requesterId        String
  requester          User                   @relation("Requester", fields: [requesterId], references: [id])
  createdById        String
  createdBy          User                   @relation("CreatedBy", fields: [createdById], references: [id])
  departmentId       String?
  department         Department?            @relation(fields: [departmentId], references: [id])
  payeeId            String
  payee              Payee                  @relation(fields: [payeeId], references: [id])
  natureOfPaymentId  String
  natureOfPayment    NatureOfPayment        @relation(fields: [natureOfPaymentId], references: [id])
  paymentOtherText   String?
  requestDate        DateTime               @db.Date
  currency           String
  totalAmount        Decimal                @db.Decimal(19, 4)
  status             RequestStatus          @default(DRAFT)
  confidentiality    Confidentiality        @default(INTERNAL)
  conditionalData    Json?
  currentVersion     Int                    @default(1)
  lockVersion        Int                    @default(0)
  submittedAt        DateTime?
  closedAt           DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  versions           RequestVersion[]
  lines              RequestLine[]
  attestations       RequestAttestation[]
  documents          SupportingDocument[]
  assignments        ApprovalAssignment[]
  decisions          ApprovalDecision[]
  generatedDocuments GeneratedDocument[]
  repositories       RepositoryRecord[]
  adjustments        AccountingAdjustment[]
  qbExports          QuickBooksExport[]
  qbPostings         QuickBooksPosting[]
  payments           Payment[]
  reconciliation     Reconciliation?
  comments           Comment[]
  histories          StatusHistory[]
  audits             AuditEvent[]

  @@index([companyId, status, createdAt])
  @@index([requesterId, status])
  @@index([payeeId, requestDate])
}

model RequestVersion {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  version   Int
  snapshot  Json
  reason    String
  createdAt DateTime @default(now())

  @@unique([requestId, version])
}

model RequestLine {
  id                    String       @id @default(cuid())
  requestId             String
  request               Request      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  position              Int
  projectCodeId         String?
  projectCode           ProjectCode? @relation("RequestedProject", fields: [projectCodeId], references: [id])
  projectCodeText       String?
  accountId             String?
  account               Account?     @relation("RequestedAccount", fields: [accountId], references: [id])
  accountText           String?
  particulars           String
  amount                Decimal      @db.Decimal(19, 4)
  adjustedProjectCodeId String?
  adjustedProjectCode   ProjectCode? @relation("AdjustedProject", fields: [adjustedProjectCodeId], references: [id])
  adjustedAccountId     String?
  adjustedAccount       Account?     @relation("AdjustedAccount", fields: [adjustedAccountId], references: [id])
  qbClass               String?
  departmentCode        String?
  costCenterCode        String?
  customerProject       String?
  taxCode               String?

  @@unique([requestId, position])
}

model RequestAttestation {
  id             String   @id @default(cuid())
  requestId      String
  request        Request  @relation(fields: [requestId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  type           String
  textVersion    String
  text           String
  requestVersion Int
  sessionIdHash  String
  createdAt      DateTime @default(now())

  @@index([requestId, requestVersion])
}

model SupportingDocument {
  id               String             @id @default(cuid())
  requestId        String
  request          Request            @relation(fields: [requestId], references: [id])
  category         String
  originalFilename String
  safeFilename     String
  storageKey       String             @unique
  mimeType         String
  sizeBytes        Int
  sha256           String
  confidentiality  Confidentiality    @default(INTERNAL)
  scanStatus       DocumentScanStatus @default(PENDING)
  uploadedById     String
  uploadedBy       User               @relation(fields: [uploadedById], references: [id])
  currentVersion   Int                @default(1)
  createdAt        DateTime           @default(now())
  deletedAt        DateTime?
  versions         DocumentVersion[]

  @@index([requestId, category])
  @@index([sha256])
}

model DocumentVersion {
  id         String             @id @default(cuid())
  documentId String
  document   SupportingDocument @relation(fields: [documentId], references: [id])
  version    Int
  storageKey String
  sha256     String
  sizeBytes  Int
  createdAt  DateTime           @default(now())

  @@unique([documentId, version])
}

model ApprovalWorkflow {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id])
  name      String
  active    Boolean         @default(true)
  stages    ApprovalStage[]
  rules     ApprovalRule[]
}

model ApprovalRule {
  id         String           @id @default(cuid())
  workflowId String
  workflow   ApprovalWorkflow @relation(fields: [workflowId], references: [id])
  priority   Int
  conditions Json
  stageKeys  Json
  active     Boolean          @default(true)
}

model ApprovalStage {
  id           String               @id @default(cuid())
  workflowId   String
  workflow     ApprovalWorkflow     @relation(fields: [workflowId], references: [id])
  key          String
  name         String
  order        Int
  mode         String
  requiredRole RoleCode
  threshold    Decimal?             @db.Decimal(19, 4)
  assignments  ApprovalAssignment[]

  @@unique([workflowId, key])
}

model ApprovalAssignment {
  id             String             @id @default(cuid())
  requestId      String
  request        Request            @relation(fields: [requestId], references: [id])
  stageId        String
  stage          ApprovalStage      @relation(fields: [stageId], references: [id])
  approverId     String
  approver       User               @relation("AssignedApprover", fields: [approverId], references: [id])
  assignedById   String?
  assignedBy     User?              @relation("AssignmentCreator", fields: [assignedById], references: [id])
  requestVersion Int
  dueAt          DateTime?
  completedAt    DateTime?
  invalidatedAt  DateTime?
  decisions      ApprovalDecision[]

  @@index([approverId, completedAt, dueAt])
}

model ApprovalDecision {
  id                 String             @id @default(cuid())
  assignmentId       String
  assignment         ApprovalAssignment @relation(fields: [assignmentId], references: [id])
  requestId          String
  request            Request            @relation(fields: [requestId], references: [id])
  approverId         String
  approver           User               @relation(fields: [approverId], references: [id])
  decision           Decision
  comment            String?
  attestationText    String?
  attestationVersion String?
  requestVersion     Int
  createdAt          DateTime           @default(now())
}

model Delegation {
  id          String   @id @default(cuid())
  delegatorId String
  delegator   User     @relation("Delegator", fields: [delegatorId], references: [id])
  delegateId  String
  delegate    User     @relation("Delegate", fields: [delegateId], references: [id])
  startsAt    DateTime
  endsAt      DateTime
  reason      String
  active      Boolean  @default(true)
}

model GeneratedDocument {
  id             String    @id @default(cuid())
  requestId      String
  request        Request   @relation(fields: [requestId], references: [id])
  type           String
  version        Int
  storageKey     String    @unique
  sha256         String
  requestVersion Int
  generatedById  String
  createdAt      DateTime  @default(now())
  supersededAt   DateTime?

  @@unique([requestId, type, version])
}

model NumberSequence {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id])
  kind        String
  prefix      String
  resetPeriod String
  periodKey   String
  nextValue   Int     @default(1)

  @@unique([companyId, kind, periodKey])
}

model RepositoryRecord {
  id             String           @id @default(cuid())
  requestId      String
  request        Request          @relation(fields: [requestId], references: [id])
  adapter        String
  objectType     String
  localObjectId  String
  destinationRef String?
  checksum       String
  status         RepositoryStatus @default(PENDING)
  attempts       Int              @default(0)
  lastError      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([adapter, objectType, localObjectId])
}

model AccountingAdjustment {
  id               String    @id @default(cuid())
  requestId        String
  request          Request   @relation(fields: [requestId], references: [id])
  lineId           String?
  field            String
  oldValue         String?
  newValue         String?
  reason           String
  changedById      String
  changedBy        User      @relation(fields: [changedById], references: [id])
  requiresApproval Boolean   @default(false)
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
}

model AccountingMapping {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id])
  mappingType String
  sourceValue String
  targetValue String
  active      Boolean @default(true)

  @@unique([companyId, mappingType, sourceValue])
}

model QuickBooksExport {
  id            String   @id @default(cuid())
  requestId     String
  request       Request  @relation(fields: [requestId], references: [id])
  version       Int
  format        String
  storageKey    String
  checksum      String
  total         Decimal  @db.Decimal(19, 4)
  generatedById String
  createdAt     DateTime @default(now())

  @@unique([requestId, version])
}

model QuickBooksPosting {
  id                    String   @id @default(cuid())
  requestId             String   @unique
  request               Request  @relation(fields: [requestId], references: [id])
  externalTransactionId String?  @unique
  manual                Boolean  @default(false)
  postingDate           DateTime @db.Date
  total                 Decimal  @db.Decimal(19, 4)
  evidenceStorageKey    String?
  postedById            String
  result                String
  createdAt             DateTime @default(now())
}

model Payment {
  id                  String            @id @default(cuid())
  requestId           String
  request             Request           @relation(fields: [requestId], references: [id])
  amount              Decimal           @db.Decimal(19, 4)
  status              PaymentStatus
  method              String
  dueDate             DateTime?         @db.Date
  paidAt              DateTime?
  reference           String?
  maskedBankReference String?
  batch               String?
  processedById       String
  processedBy         User              @relation(fields: [processedById], references: [id])
  createdAt           DateTime          @default(now())
  evidence            PaymentEvidence[]

  @@index([requestId, status])
}

model PaymentEvidence {
  id               String   @id @default(cuid())
  paymentId        String
  payment          Payment  @relation(fields: [paymentId], references: [id])
  storageKey       String
  sha256           String
  originalFilename String
  createdAt        DateTime @default(now())
}

model Reconciliation {
  id                 String    @id @default(cuid())
  requestId          String    @unique
  request            Request   @relation(fields: [requestId], references: [id])
  bankReference      String?
  settlementDate     DateTime? @db.Date
  requestedAmount    Decimal   @db.Decimal(19, 4)
  postedAmount       Decimal   @db.Decimal(19, 4)
  paidAmount         Decimal   @db.Decimal(19, 4)
  settledAmount      Decimal   @db.Decimal(19, 4)
  variance           Decimal   @db.Decimal(19, 4)
  varianceReason     String?
  evidenceStorageKey String?
  reconciledById     String
  reconciledBy       User      @relation(fields: [reconciledById], references: [id])
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  type       String
  title      String
  body       String
  recordType String?
  recordId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model Comment {
  id         String   @id @default(cuid())
  requestId  String
  request    Request  @relation(fields: [requestId], references: [id])
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  body       String
  visibility String
  createdAt  DateTime @default(now())
}

model StatusHistory {
  id             String         @id @default(cuid())
  requestId      String
  request        Request        @relation(fields: [requestId], references: [id])
  fromStatus     RequestStatus?
  toStatus       RequestStatus
  actorId        String?
  reason         String?
  requestVersion Int
  createdAt      DateTime       @default(now())

  @@index([requestId, createdAt])
}

model AuditEvent {
  id            String   @id @default(cuid())
  requestId     String?
  request       Request? @relation(fields: [requestId], references: [id])
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id])
  action        String
  entityType    String
  entityId      String
  before        Json?
  after         Json?
  metadata      Json?
  ipHash        String?
  userAgentHash String?
  createdAt     DateTime @default(now())

  @@index([requestId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model IntegrationJob {
  id          String    @id @default(cuid())
  type        String
  status      JobStatus @default(PENDING)
  recordType  String
  recordId    String
  payload     Json
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAfter    DateTime  @default(now())
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAfter])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  sensitive   Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @updatedAt
}
